# --- GitHub Pages 真 AI（Cloudflare Worker + Railway Hermes + 千问）---
# 在仓库 Settings → Secrets → Actions 配置同名 Secret 后推送 main 生效
# VITE_ENABLE_LIVE_CHAT=1
# VITE_AI_CHAT_ENDPOINT=https://你的子域.workers.dev/api/chat

# --- 本地开发：先启动 api-worker（npm run dev）或旧版 proxy ---
# VITE_ENABLE_LIVE_CHAT=1
# VITE_AI_CHAT_ENDPOINT=http://127.0.0.1:8787/api/chat

# 未配置上述变量时，对话页仍使用演示剧本（适合录屏）

# --- 旧版 RAGFlow 本地代理（可选，见 proxy/README.md）---
# VITE_RAGFLOW_MODE=proxy
# VITE_RAGFLOW_CHAT_ENDPOINT=http://127.0.0.1:8787/api/ragflow/chat

# 演示节奏（可选）
# VITE_CHAT_PLAYBACK=0

# 管理后台跳转地址（/app/admin 自动跳转）
# VITE_ADMIN_PORTAL_URL=https://fangjg16.github.io/family-office-admin-portal/
